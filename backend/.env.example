# =============================================================================
# Vela Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Variables marked [Required] must be set. Others are optional but enable features.
# =============================================================================

# === REQUIRED: Core Functionality ===
# Get your Gemini API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key

# Your custom API key for client authentication (mobile app, external clients).
# Generate a secure random string: openssl rand -hex 32
VELA_API_KEY=your_secure_vela_api_key

# === REQUIRED: PostgreSQL Database (e.g., Neon, Supabase, or Local Postgres) ===
# PostgreSQL connection string (use the postgresql:// or postgres:// URI).
# Format (Neon): postgresql://[user]:[password]@[project].neon.tech/[dbname]?sslmode=require
# Format (Supabase): postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
# Format (Local): postgresql://postgres:[password]@localhost:5432/vela
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_db?sslmode=require


# === OPTIONAL: Supabase specific configuration ===
# (Only required if you are using specific Supabase clients in front-end or customized features)
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# === OPTIONAL: External Tool APIs ===
# Without these, the corresponding tools will be unavailable but the server runs fine.

# Web search (free tier: 1000 searches/month) → https://tavily.com
TAVILY_API_KEY=your_tavily_api_key

# Sandboxed code execution → https://e2b.dev
E2B_API_KEY=your_e2b_api_key

# GitHub API (for code-related tools) → https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token


# === OPTIONAL: Chat Platform Gateways ===
# Without these tokens, the corresponding gateway stays offline.

# Telegram Bot → get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Discord Bot → https://discord.com/developers/applications → Bot → Reset Token
DISCORD_BOT_TOKEN=your_discord_bot_token


# === OPTIONAL: Google OAuth (Gmail/Calendar integration) ===
# Set these up in Google Cloud Console → APIs & Services → Credentials
# Required redirect URI: http://localhost:8000/oauth/callback (for local dev)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# Optional: Global Google credentials for saving to Google Drive without per-user OAuth
GOOGLE_REFRESH_TOKEN=your_global_google_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_specific_google_drive_folder_id


# === OPTIONAL: LLM Provider Fallbacks ===
# Primary provider is Gemini (GOOGLE_API_KEY above).
# These are tried in order if Gemini fails.

# Groq (fast, free tier) → https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# OpenRouter (multi-model) → https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Cohere → https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key


# === OPTIONAL: Embedding Provider Fallbacks ===
# Primary embedding is Gemini Embedding 2 (uses GOOGLE_API_KEY).
# These are fallbacks if the primary fails.

# Voyage AI → https://www.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key

# Jina → https://jina.ai/
JINA_API_KEY=your_jina_api_key
