{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "image": "latest",
        "resourceClass": "medium"
      },
      "cache": {
        "disabled": false
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview"
      },
      "android": {
        "buildType": "apk",
        "image": "latest",
        "resourceClass": "medium"
      },
      "cache": {
        "disabled": false
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "apk",
        "image": "latest",
        "resourceClass": "medium"
      },
      "cache": {
        "disabled": false
      },
      "env": {
        "APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
